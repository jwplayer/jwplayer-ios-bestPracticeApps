# The iOS apps use Swift Package Manager. Only the tvOS app still uses CocoaPods,
# because JWPlayerTVKit is not available as a Swift package.

####################################
#### JWPlayerTVKit tvOS targets ####
####################################

workspace 'JWBestPracticeApps-4x'

def common_JWPlayerTVKit
  platform :tvos, '15.0'
  use_frameworks!
  
  pod 'JWPlayerTVKit', '~> 1'
end

target 'BasicTVPlayer' do
  project 'BasicTVPlayer/BasicTVPlayer'
  common_JWPlayerTVKit
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
